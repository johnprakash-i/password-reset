NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/password-reset?appName=Cluster0

# Your Netlify frontend URL (no trailing slash)
CLIENT_URL=https://YOUR-SITE.netlify.app

RESET_TOKEN_EXPIRY_MINUTES=15

# Email via Resend (required on Render — SMTP ports are blocked on the free tier)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="SecureReset <onboarding@resend.dev>"
