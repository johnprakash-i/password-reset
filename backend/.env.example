NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/password-reset

# Frontend URL used in reset email links + CORS
# Local: http://localhost:5173
# Production: https://YOUR-SITE.netlify.app
CLIENT_URL=http://localhost:5173

# Password reset token lifetime in minutes
RESET_TOKEN_EXPIRY_MINUTES=15

# --- Email (option 1, preferred): Resend HTTP API ---
# Works on Render free tier (no SMTP ports needed). Get a key: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# From address. Use onboarding@resend.dev until you verify your own domain in Resend.
EMAIL_FROM="SecureReset <onboarding@resend.dev>"

# --- Email (option 2, fallback): SMTP ---
# Only used when RESEND_API_KEY is not set. Blocked on Render free tier.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
